import { Palette, Typography } from "tokens.slint";
import { MetricTile, TileState } from "tile.slint";

export enum ConnectionStatus { waiting, connected, stale }

export component AppWindow inherits Window {
    title: "Sentinel";
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Palette.background;

    in property <ConnectionStatus> status: ConnectionStatus.waiting;
    in property <string> agent-version: "";
    in property <string> uptime: "";

    in property <string> cpu-utilization: "--";
    in property <string> cpu-temperature: "--";
    in property <string> gpu-utilization: "--";
    in property <string> gpu-temperature: "--";
    in property <string> gpu-hotspot-temperature: "--";
    in property <string> gpu-vram-used-gb: "--";
    in property <string> ram-used-gb: "--";

    in property <TileState> cpu-utilization-state: TileState.normal;
    in property <TileState> cpu-temperature-state: TileState.normal;
    in property <TileState> gpu-utilization-state: TileState.normal;
    in property <TileState> gpu-temperature-state: TileState.normal;
    in property <TileState> gpu-hotspot-state: TileState.normal;
    in property <TileState> vram-state: TileState.normal;
    in property <TileState> ram-state: TileState.normal;

    in property <string> vram-utilization: "--";
    in property <string> ram-utilization: "--";

    in property <string> cpu-utilization-cool: "";
    in property <string> cpu-utilization-warm: "";
    in property <string> cpu-utilization-hot: "";
    in property <string> cpu-temperature-cool: "";
    in property <string> cpu-temperature-warm: "";
    in property <string> cpu-temperature-hot: "";
    in property <string> gpu-utilization-cool: "";
    in property <string> gpu-utilization-warm: "";
    in property <string> gpu-utilization-hot: "";
    in property <string> gpu-temperature-cool: "";
    in property <string> gpu-temperature-warm: "";
    in property <string> gpu-temperature-hot: "";
    in property <string> gpu-hotspot-cool: "";
    in property <string> gpu-hotspot-warm: "";
    in property <string> gpu-hotspot-hot: "";
    in property <string> gpu-vram-cool: "";
    in property <string> gpu-vram-warm: "";
    in property <string> gpu-vram-hot: "";
    in property <string> ram-cool: "";
    in property <string> ram-warm: "";
    in property <string> ram-hot: "";

    if root.status == ConnectionStatus.waiting : VerticalLayout {
        alignment: center;
        spacing: 8px;
        Text {
            text: "⏳";
            horizontal-alignment: center;
            font-size: 48px;
        }
        Text {
            text: "Waiting for PC";
            color: Palette.text-primary;
            horizontal-alignment: center;
            font-size: Typography.heading;
        }
    }

    if root.status == ConnectionStatus.connected : VerticalLayout {
        padding: 16px;
        spacing: 16px;
        alignment: start;

        HorizontalLayout {
            Text {
                text: root.agent-version;
                color: Palette.success;
                font-size: Typography.caption;
                horizontal-stretch: 1;
            }
            Text {
                text: root.uptime;
                color: Palette.text-secondary;
                font-size: Typography.caption;
                horizontal-alignment: right;
            }
        }

        VerticalLayout {
            spacing: 8px;
            alignment: start;
            Text {
                text: "CPU";
                color: Palette.text-secondary;
                font-size: Typography.body;
            }
            HorizontalLayout {
                spacing: 8px;
                MetricTile {
                    label: "Usage"; value: root.cpu-utilization; unit: "%";
                    state: root.cpu-utilization-state;
                    hot-icon: "⚡"; warm-icon: "📶";
                    sparkline-cool: root.cpu-utilization-cool;
                    sparkline-warm: root.cpu-utilization-warm;
                    sparkline-hot: root.cpu-utilization-hot;
                    width: (parent.width - 8px) / 2;
                }
                MetricTile {
                    label: "Temperature"; value: root.cpu-temperature; unit: "°C";
                    state: root.cpu-temperature-state;
                    sparkline-cool: root.cpu-temperature-cool;
                    sparkline-warm: root.cpu-temperature-warm;
                    sparkline-hot: root.cpu-temperature-hot;
                    width: (parent.width - 8px) / 2;
                }
            }
        }

        VerticalLayout {
            spacing: 8px;
            alignment: start;
            Text {
                text: "GPU";
                color: Palette.text-secondary;
                font-size: Typography.body;
            }
            HorizontalLayout {
                spacing: 8px;
                MetricTile {
                    label: "Usage"; value: root.gpu-utilization; unit: "%";
                    state: root.gpu-utilization-state;
                    hot-icon: "⚡"; warm-icon: "📶";
                    sparkline-cool: root.gpu-utilization-cool;
                    sparkline-warm: root.gpu-utilization-warm;
                    sparkline-hot: root.gpu-utilization-hot;
                    width: (parent.width - 8px) / 2;
                }
                MetricTile {
                    label: "Temperature"; value: root.gpu-temperature; unit: "°C";
                    state: root.gpu-temperature-state;
                    sparkline-cool: root.gpu-temperature-cool;
                    sparkline-warm: root.gpu-temperature-warm;
                    sparkline-hot: root.gpu-temperature-hot;
                    width: (parent.width - 8px) / 2;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                MetricTile {
                    label: "Hotspot"; value: root.gpu-hotspot-temperature; unit: "°C";
                    state: root.gpu-hotspot-state;
                    sparkline-cool: root.gpu-hotspot-cool;
                    sparkline-warm: root.gpu-hotspot-warm;
                    sparkline-hot: root.gpu-hotspot-hot;
                    width: (parent.width - 8px) / 2;
                }
                MetricTile {
                    label: "VRAM"; value: root.gpu-vram-used-gb; unit: "GB";
                    sub-value: root.vram-utilization; state: root.vram-state;
                    hot-icon: "⚡"; warm-icon: "📶";
                    sparkline-cool: root.gpu-vram-cool;
                    sparkline-warm: root.gpu-vram-warm;
                    sparkline-hot: root.gpu-vram-hot;
                    width: (parent.width - 8px) / 2;
                }
            }
        }

        VerticalLayout {
            spacing: 8px;
            alignment: start;
            Text {
                text: "RAM";
                color: Palette.text-secondary;
                font-size: Typography.body;
            }
            HorizontalLayout {
                MetricTile {
                    label: "Memory"; value: root.ram-used-gb; unit: "GB";
                    sub-value: root.ram-utilization; state: root.ram-state;
                    hot-icon: "⚡"; warm-icon: "📶";
                    sparkline-cool: root.ram-cool;
                    sparkline-warm: root.ram-warm;
                    sparkline-hot: root.ram-hot;
                    horizontal-stretch: 1;
                }
            }
        }
    }

    if root.status == ConnectionStatus.stale : VerticalLayout {
        alignment: center;
        spacing: 8px;
        Text {
            text: "⚠️";
            horizontal-alignment: center;
            font-size: 48px;
        }
        Text {
            text: "No signal";
            color: Palette.warning;
            horizontal-alignment: center;
            font-size: Typography.heading;
        }
        Text {
            text: root.agent-version;
            color: Palette.text-secondary;
            horizontal-alignment: center;
            font-size: Typography.caption;
        }
    }
}
