import { Palette, Typography } from "tokens.slint";
import { MetricTile, TileState } from "tile.slint";

export enum ConnectionStatus { waiting, connected, stale }

export struct GameCardData {
    app-id: string,
    name: string,
    cover-art: image,
    has-cover-art: bool,
}

export component AppWindow inherits Window {
    title: "Sentinel";
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Palette.background;

    in property <ConnectionStatus> status: ConnectionStatus.waiting;
    in property <string> agent-version: "";
    in property <string> uptime: "";

    in property <string> cpu-utilization: "--";
    in property <string> cpu-temperature: "--";
    in property <string> gpu-utilization: "--";
    in property <string> gpu-temperature: "--";
    in property <string> gpu-hotspot-temperature: "--";
    in property <string> gpu-vram-used-gb: "--";
    in property <string> ram-used-gb: "--";

    in property <TileState> cpu-utilization-state: TileState.normal;
    in property <TileState> cpu-temperature-state: TileState.normal;
    in property <TileState> gpu-utilization-state: TileState.normal;
    in property <TileState> gpu-temperature-state: TileState.normal;
    in property <TileState> gpu-hotspot-state: TileState.normal;
    in property <TileState> vram-state: TileState.normal;
    in property <TileState> ram-state: TileState.normal;

    in property <string> vram-utilization: "--";
    in property <string> ram-utilization: "--";

    in property <string> cpu-utilization-cool: "";
    in property <string> cpu-utilization-warm: "";
    in property <string> cpu-utilization-hot: "";
    in property <string> cpu-temperature-cool: "";
    in property <string> cpu-temperature-warm: "";
    in property <string> cpu-temperature-hot: "";
    in property <string> gpu-utilization-cool: "";
    in property <string> gpu-utilization-warm: "";
    in property <string> gpu-utilization-hot: "";
    in property <string> gpu-temperature-cool: "";
    in property <string> gpu-temperature-warm: "";
    in property <string> gpu-temperature-hot: "";
    in property <string> gpu-hotspot-cool: "";
    in property <string> gpu-hotspot-warm: "";
    in property <string> gpu-hotspot-hot: "";
    in property <string> gpu-vram-cool: "";
    in property <string> gpu-vram-warm: "";
    in property <string> gpu-vram-hot: "";
    in property <string> ram-cool: "";
    in property <string> ram-warm: "";
    in property <string> ram-hot: "";

    in property <string> cpu-name: "";
    in property <string> cpu-cores-threads: "";
    in property <string> cpu-boost-clock: "";
    in property <string> gpu-name: "";
    in property <string> gpu-vram-total: "";
    in property <string> ram-name: "";
    in property <string> ram-total: "";
    in property <string> ram-speed: "";
    in property <string> os-version: "";
    in property <string> game-name: "";
    in property <image> game-cover-art;
    in property <bool> has-game-cover-art: false;
    in property <[GameCardData]> game-library: [];
    in-out property <bool> show-specs: false;
    in-out property <bool> show-commands: false;
    callback action-pressed(action-id: string);
    in property <bool> action-pending: false;
    in property <string> action-result: "";
    private property <length> nav-bar-height: 52px;
    private property <bool> has-action-error: !root.action-pending && root.action-result != "" && root.action-result != "ok";

    if root.status == ConnectionStatus.waiting : VerticalLayout {
        alignment: center;
        spacing: 16px;
        Text {
            text: "SENTINEL";
            color: Palette.text-primary;
            horizontal-alignment: center;
            font-size: Typography.heading;
        }
        Text {
            text: "Waiting for PC...";
            color: Palette.text-secondary;
            horizontal-alignment: center;
            font-size: Typography.body;
        }
    }

    if root.status == ConnectionStatus.connected : VerticalLayout {

        // ── Status page ──────────────────────────────────────────────────────
        if !root.show-commands : VerticalLayout {
            vertical-stretch: 1;
            padding: 16px;
            spacing: 16px;
            alignment: start;

            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: root.agent-version;
                    color: Palette.success;
                    font-size: Typography.caption;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.uptime;
                    color: Palette.text-secondary;
                    font-size: Typography.caption;
                }
                Rectangle {
                    specs-ta := TouchArea {
                        clicked => { root.show-specs = true; }
                    }
                    Text {
                        text: "Specs →";
                        color: specs-ta.has-hover ? Palette.text-primary : Palette.text-secondary;
                        font-size: Typography.caption;
                        vertical-alignment: center;
                    }
                }
            }

            VerticalLayout {
                spacing: 8px;
                alignment: start;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Text {
                        text: "CPU";
                        color: Palette.text-secondary;
                        font-size: Typography.body;
                    }
                    if root.cpu-name != "" : Text {
                        text: "· " + root.cpu-name;
                        color: Palette.text-secondary;
                        font-size: Typography.caption;
                        vertical-alignment: bottom;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    MetricTile {
                        label: "Usage"; value: root.cpu-utilization; unit: "%";
                        state: root.cpu-utilization-state;
                        hot-icon: "⚡"; warm-icon: "📶";
                        sparkline-cool: root.cpu-utilization-cool;
                        sparkline-warm: root.cpu-utilization-warm;
                        sparkline-hot: root.cpu-utilization-hot;
                        width: (parent.width - 8px) / 2;
                    }
                    MetricTile {
                        label: "Temperature"; value: root.cpu-temperature; unit: "°C";
                        state: root.cpu-temperature-state;
                        sparkline-cool: root.cpu-temperature-cool;
                        sparkline-warm: root.cpu-temperature-warm;
                        sparkline-hot: root.cpu-temperature-hot;
                        width: (parent.width - 8px) / 2;
                    }
                }
            }

            VerticalLayout {
                spacing: 8px;
                alignment: start;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Text {
                        text: "GPU";
                        color: Palette.text-secondary;
                        font-size: Typography.body;
                    }
                    if root.gpu-name != "" : Text {
                        text: "· " + root.gpu-name;
                        color: Palette.text-secondary;
                        font-size: Typography.caption;
                        vertical-alignment: bottom;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    MetricTile {
                        label: "Usage"; value: root.gpu-utilization; unit: "%";
                        state: root.gpu-utilization-state;
                        hot-icon: "⚡"; warm-icon: "📶";
                        sparkline-cool: root.gpu-utilization-cool;
                        sparkline-warm: root.gpu-utilization-warm;
                        sparkline-hot: root.gpu-utilization-hot;
                        width: (parent.width - 8px) / 2;
                    }
                    MetricTile {
                        label: "Temperature"; value: root.gpu-temperature; unit: "°C";
                        state: root.gpu-temperature-state;
                        sparkline-cool: root.gpu-temperature-cool;
                        sparkline-warm: root.gpu-temperature-warm;
                        sparkline-hot: root.gpu-temperature-hot;
                        width: (parent.width - 8px) / 2;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    MetricTile {
                        label: "Hotspot"; value: root.gpu-hotspot-temperature; unit: "°C";
                        state: root.gpu-hotspot-state;
                        sparkline-cool: root.gpu-hotspot-cool;
                        sparkline-warm: root.gpu-hotspot-warm;
                        sparkline-hot: root.gpu-hotspot-hot;
                        width: (parent.width - 8px) / 2;
                    }
                    MetricTile {
                        label: "VRAM"; value: root.gpu-vram-used-gb; unit: "GB";
                        sub-value: root.vram-utilization; state: root.vram-state;
                        hot-icon: "⚡"; warm-icon: "📶";
                        sparkline-cool: root.gpu-vram-cool;
                        sparkline-warm: root.gpu-vram-warm;
                        sparkline-hot: root.gpu-vram-hot;
                        width: (parent.width - 8px) / 2;
                    }
                }
            }

            VerticalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: "RAM";
                    color: Palette.text-secondary;
                    font-size: Typography.body;
                }
                HorizontalLayout {
                    MetricTile {
                        label: "Memory"; value: root.ram-used-gb; unit: "GB";
                        sub-value: root.ram-utilization; state: root.ram-state;
                        hot-icon: "⚡"; warm-icon: "📶";
                        sparkline-cool: root.ram-cool;
                        sparkline-warm: root.ram-warm;
                        sparkline-hot: root.ram-hot;
                        horizontal-stretch: 1;
                    }
                }
            }
        }

        // ── Command Center page ───────────────────────────────────────────────
        if root.show-commands : VerticalLayout {
            vertical-stretch: 1;
            padding: 16px;
            spacing: 12px;

            // Steam button + inline action feedback
            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                Rectangle {
                    height: 44px;
                    width: 160px;
                    background: Palette.surface;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Palette.border;
                    steam-ta := TouchArea {
                        enabled: !root.action-pending;
                        clicked => { root.action-pressed("launch_steam"); }
                    }
                    Text {
                        text: "Launch Steam";
                        color: root.action-pending ? Palette.text-secondary : Palette.text-primary;
                        font-size: Typography.body;
                        width: parent.width;
                        height: parent.height;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                if root.action-pending : Text {
                    text: "Sending...";
                    color: Palette.text-secondary;
                    font-size: Typography.caption;
                    height: 44px;
                    vertical-alignment: center;
                }
                if !root.action-pending && root.action-result == "ok" : Text {
                    text: "✓ Done";
                    color: Palette.success;
                    font-size: Typography.caption;
                    height: 44px;
                    vertical-alignment: center;
                }
                if root.has-action-error : Text {
                    text: root.action-result;
                    color: Palette.error;
                    font-size: Typography.caption;
                    height: 44px;
                    vertical-alignment: center;
                }
            }

            // Game library grid (6-per-row portrait cards)
            if root.game-library.length > 0 : Flickable {
                vertical-stretch: 1;
                interactive: true;
                content-height: max(self.height, floor((root.game-library.length + 5) / 6) * ((self.width - 40px) / 6 * 3 / 2 + 8px));

                for card[i] in root.game-library : Rectangle {
                    private property <length> cw: (parent.width - 40px) / 6;
                    x: mod(i, 6) * (cw + 8px);
                    y: floor(i / 6) * (cw * 3 / 2 + 8px);
                    width: cw;
                    height: cw * 3 / 2;
                    border-radius: 6px;
                    clip: true;
                    background: Palette.surface;

                    card-ta := TouchArea {
                        enabled: !root.action-pending;
                        clicked => { root.action-pressed("launch_game_" + card.app-id); }
                    }
                    if card.has-cover-art : Image {
                        source: card.cover-art;
                        width: parent.width;
                        height: parent.height;
                        image-fit: cover;
                    }
                    if !card.has-cover-art : Rectangle {
                        y: parent.height - self.height;
                        width: parent.width;
                        height: 36px;
                        background: @linear-gradient(180deg, transparent, #000000cc);
                        Text {
                            text: card.name;
                            color: #ffffff;
                            font-size: Typography.caption;
                            overflow: elide;
                            x: 4px;
                            width: parent.width - 8px;
                            height: parent.height;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Fallback: last-played single card when no library data yet
            if root.game-library.length == 0 && root.game-name != "" : Rectangle {
                private property <length> card-w: (parent.width - 5 * 8px) / 6;
                width: card-w;
                height: card-w * 3 / 2;
                border-radius: 6px;
                clip: true;
                background: Palette.surface;
                game-card-ta := TouchArea {
                    enabled: !root.action-pending;
                    clicked => { root.action-pressed("launch_last_game"); }
                }
                if root.has-game-cover-art : Image {
                    source: root.game-cover-art;
                    width: parent.width;
                    height: parent.height;
                    image-fit: cover;
                }
                if !root.has-game-cover-art : Rectangle {
                    y: parent.height - self.height;
                    width: parent.width;
                    height: 36px;
                    background: @linear-gradient(180deg, transparent, #000000cc);
                    Text {
                        text: root.game-name;
                        color: #ffffff;
                        font-size: Typography.caption;
                        overflow: elide;
                        x: 6px;
                        width: parent.width - 12px;
                        height: parent.height;
                        vertical-alignment: center;
                    }
                }
            }

            // Fallback button when no library and no game-name
            if root.game-library.length == 0 && root.game-name == "" : Rectangle {
                height: 48px;
                background: Palette.surface;
                border-radius: 8px;
                border-width: 1px;
                border-color: Palette.border;
                last-game-ta := TouchArea {
                    enabled: !root.action-pending;
                    clicked => { root.action-pressed("launch_last_game"); }
                }
                Text {
                    text: "Last Game";
                    color: root.action-pending ? Palette.text-secondary : Palette.text-primary;
                    font-size: Typography.body;
                    width: parent.width;
                    height: parent.height;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // ── Nav bar ───────────────────────────────────────────────────────────
        Rectangle {
            height: root.nav-bar-height;
            background: Palette.surface;

            VerticalLayout {
                Rectangle { height: 1px; background: Palette.border; }

                HorizontalLayout {
                    vertical-stretch: 1;

                    Rectangle {
                        status-ta := TouchArea {
                            clicked => { root.show-commands = false; root.show-specs = false; }
                        }
                        if !root.show-commands : Rectangle {
                            x: 0; y: 0;
                            width: parent.width;
                            height: 3px;
                            background: Palette.cool;
                        }
                        Text {
                            text: "Status";
                            color: !root.show-commands ? Palette.text-primary : Palette.text-secondary;
                            font-size: Typography.body;
                            width: parent.width;
                            height: parent.height;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        commands-ta := TouchArea {
                            clicked => { root.show-commands = true; root.show-specs = false; }
                        }
                        if root.show-commands : Rectangle {
                            x: 0; y: 0;
                            width: parent.width;
                            height: 3px;
                            background: Palette.cool;
                        }
                        Text {
                            text: "Commands";
                            color: root.show-commands ? Palette.text-primary : Palette.text-secondary;
                            font-size: Typography.body;
                            width: parent.width;
                            height: parent.height;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    if root.status == ConnectionStatus.stale : VerticalLayout {
        alignment: center;
        spacing: 12px;
        Text {
            text: "⚠";
            color: Palette.warning;
            horizontal-alignment: center;
            font-size: 48px;
        }
        Text {
            text: "Connection lost";
            color: Palette.warning;
            horizontal-alignment: center;
            font-size: Typography.heading;
        }
        Text {
            text: root.agent-version;
            color: Palette.text-secondary;
            horizontal-alignment: center;
            font-size: Typography.caption;
        }
    }

    if root.show-specs : Rectangle {
        y: 0;
        height: parent.height - root.nav-bar-height;
        background: Palette.background;

        VerticalLayout {
            padding: 24px;
            spacing: 20px;

            HorizontalLayout {
                Rectangle {
                    width: 64px;
                    height: 28px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Palette.border;
                    back-ta := TouchArea {
                        clicked => { root.show-specs = false; }
                    }
                    Text {
                        text: "← Back";
                        color: back-ta.has-hover ? Palette.text-primary : Palette.text-secondary;
                        font-size: Typography.caption;
                        width: parent.width;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: "SPECS";
                    color: Palette.text-primary;
                    font-size: Typography.heading;
                    horizontal-stretch: 1;
                    horizontal-alignment: center;
                }
                Rectangle { width: 64px; }
            }

            HorizontalLayout {
                spacing: 16px;

                Rectangle {
                    width: (parent.width - 16px) / 2;
                    background: Palette.surface;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Palette.border;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 6px;
                        alignment: start;
                        Text { text: "CPU"; color: Palette.text-secondary; font-size: Typography.caption; }
                        Text { text: root.cpu-name; color: Palette.text-primary; font-size: Typography.body; }
                        Text { text: root.cpu-cores-threads; color: Palette.text-secondary; font-size: Typography.caption; }
                        Text { text: root.cpu-boost-clock; color: Palette.text-secondary; font-size: Typography.caption; }
                    }
                }

                Rectangle {
                    width: (parent.width - 16px) / 2;
                    background: Palette.surface;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Palette.border;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 6px;
                        alignment: start;
                        Text { text: "GPU"; color: Palette.text-secondary; font-size: Typography.caption; }
                        Text { text: root.gpu-name; color: Palette.text-primary; font-size: Typography.body; }
                        Text { text: root.gpu-vram-total + " VRAM"; color: Palette.text-secondary; font-size: Typography.caption; }
                    }
                }
            }

            HorizontalLayout {
                spacing: 16px;

                Rectangle {
                    width: (parent.width - 16px) / 2;
                    background: Palette.surface;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Palette.border;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 6px;
                        alignment: start;
                        Text { text: "RAM"; color: Palette.text-secondary; font-size: Typography.caption; }
                        Text { text: root.ram-name; color: Palette.text-primary; font-size: Typography.body; }
                        Text { text: root.ram-total + " · " + root.ram-speed; color: Palette.text-secondary; font-size: Typography.caption; }
                    }
                }

                Rectangle {
                    width: (parent.width - 16px) / 2;
                    background: Palette.surface;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Palette.border;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 6px;
                        alignment: start;
                        Text { text: "SYSTEM"; color: Palette.text-secondary; font-size: Typography.caption; }
                        Text { text: root.os-version; color: Palette.text-primary; font-size: Typography.body; }
                    }
                }
            }
        }
    }
}
