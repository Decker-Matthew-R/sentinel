import { Palette, Typography } from "tokens.slint";
import { MetricTile, TileState } from "tile.slint";

export enum ConnectionStatus { waiting, connected, stale }

export component AppWindow inherits Window {
    title: "Sentinel";
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Palette.background;

    in property <ConnectionStatus> status: ConnectionStatus.waiting;
    in property <string> agent-version: "";
    in property <string> uptime: "";

    in property <string> cpu-utilization: "--";
    in property <string> cpu-temperature: "--";
    in property <string> gpu-utilization: "--";
    in property <string> gpu-temperature: "--";
    in property <string> gpu-hotspot-temperature: "--";
    in property <string> gpu-vram-used-gb: "--";
    in property <string> ram-used-gb: "--";

    in property <TileState> cpu-temperature-state: TileState.normal;
    in property <TileState> gpu-temperature-state: TileState.normal;
    in property <TileState> gpu-hotspot-state: TileState.normal;
    in property <TileState> vram-state: TileState.normal;
    in property <TileState> ram-state: TileState.normal;

    in property <string> vram-utilization: "--";
    in property <string> ram-utilization: "--";

    in property <string> cpu-utilization-sparkline: "";
    in property <string> cpu-temperature-sparkline: "";
    in property <string> gpu-utilization-sparkline: "";
    in property <string> gpu-temperature-sparkline: "";
    in property <string> gpu-hotspot-sparkline: "";
    in property <string> gpu-vram-sparkline: "";
    in property <string> ram-sparkline: "";

    if root.status == ConnectionStatus.waiting : VerticalLayout {
        alignment: center;
        spacing: 8px;
        Text {
            text: "⏳";
            horizontal-alignment: center;
            font-size: 48px;
        }
        Text {
            text: "Waiting for PC";
            color: Palette.text-primary;
            horizontal-alignment: center;
            font-size: Typography.heading;
        }
    }

    if root.status == ConnectionStatus.connected : VerticalLayout {
        padding: 16px;
        spacing: 16px;
        alignment: start;

        HorizontalLayout {
            Text {
                text: root.agent-version;
                color: Palette.success;
                font-size: Typography.caption;
                horizontal-stretch: 1;
            }
            Text {
                text: root.uptime;
                color: Palette.text-secondary;
                font-size: Typography.caption;
                horizontal-alignment: right;
            }
        }

        VerticalLayout {
            spacing: 8px;
            alignment: start;
            Text {
                text: "CPU";
                color: Palette.text-secondary;
                font-size: Typography.body;
            }
            HorizontalLayout {
                spacing: 8px;
                MetricTile { label: "Usage"; value: root.cpu-utilization; unit: "%"; sparkline-path: root.cpu-utilization-sparkline; width: (parent.width - 8px) / 2; }
                MetricTile { label: "Temperature"; value: root.cpu-temperature; unit: "°C"; state: root.cpu-temperature-state; sparkline-path: root.cpu-temperature-sparkline; width: (parent.width - 8px) / 2; }
            }
        }

        VerticalLayout {
            spacing: 8px;
            alignment: start;
            Text {
                text: "GPU";
                color: Palette.text-secondary;
                font-size: Typography.body;
            }
            HorizontalLayout {
                spacing: 8px;
                MetricTile { label: "Usage"; value: root.gpu-utilization; unit: "%"; sparkline-path: root.gpu-utilization-sparkline; width: (parent.width - 8px) / 2; }
                MetricTile { label: "Temperature"; value: root.gpu-temperature; unit: "°C"; state: root.gpu-temperature-state; sparkline-path: root.gpu-temperature-sparkline; width: (parent.width - 8px) / 2; }
            }
            HorizontalLayout {
                spacing: 8px;
                MetricTile { label: "Hotspot"; value: root.gpu-hotspot-temperature; unit: "°C"; state: root.gpu-hotspot-state; sparkline-path: root.gpu-hotspot-sparkline; width: (parent.width - 8px) / 2; }
                MetricTile { label: "VRAM"; value: root.gpu-vram-used-gb; unit: "GB"; sub-value: root.vram-utilization; state: root.vram-state; sparkline-path: root.gpu-vram-sparkline; width: (parent.width - 8px) / 2; }
            }
        }

        VerticalLayout {
            spacing: 8px;
            alignment: start;
            Text {
                text: "RAM";
                color: Palette.text-secondary;
                font-size: Typography.body;
            }
            HorizontalLayout {
                MetricTile { label: "Memory"; value: root.ram-used-gb; unit: "GB"; sub-value: root.ram-utilization; state: root.ram-state; sparkline-path: root.ram-sparkline; horizontal-stretch: 1; }
            }
        }
    }

    if root.status == ConnectionStatus.stale : VerticalLayout {
        alignment: center;
        spacing: 8px;
        Text {
            text: "⚠️";
            horizontal-alignment: center;
            font-size: 48px;
        }
        Text {
            text: "No signal";
            color: Palette.warning;
            horizontal-alignment: center;
            font-size: Typography.heading;
        }
        Text {
            text: root.agent-version;
            color: Palette.text-secondary;
            horizontal-alignment: center;
            font-size: Typography.caption;
        }
    }
}
