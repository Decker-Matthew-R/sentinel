import { Palette, Typography } from "tokens.slint";
import { Sparkline } from "sparkline.slint";

export enum TileState { normal, warm, hot }

export component MetricTile inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "--";
    in property <string> unit: "";
    in property <string> sub-value: "";
    in property <TileState> state: TileState.normal;
    in property <string> sparkline-cool: "";
    in property <string> sparkline-warm: "";
    in property <string> sparkline-hot: "";
    in property <string> hot-icon: "🔥";
    in property <string> warm-icon: "⚠️";
    in property <string> cool-icon: "❄️";

    property <color> value-color: root.state == TileState.hot ? Palette.error :
                                   root.state == TileState.warm ? Palette.warning :
                                   Palette.cool;

    min-width: 0;
    background: Palette.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;
    height: 130px;

    VerticalLayout {
        padding: 12px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 4px;
            Text {
                text: root.label;
                color: Palette.text-secondary;
                font-size: Typography.caption;
                horizontal-stretch: 1;
            }
            Text {
                text: root.state == TileState.hot ? root.hot-icon :
                      root.state == TileState.warm ? root.warm-icon : root.cool-icon;
                font-size: Typography.caption;
            }
        }

        HorizontalLayout {
            spacing: 4px;
            alignment: start;

            Text {
                text: root.value;
                color: root.value-color;
                font-size: Typography.value;
            }

            Text {
                text: root.unit;
                color: Palette.text-secondary;
                font-size: Typography.body;
                vertical-alignment: bottom;
            }
        }

        Rectangle {
            vertical-stretch: 1;
            Sparkline {
                width: parent.width;
                height: parent.height;
                cool-path: root.sparkline-cool;
                warm-path: root.sparkline-warm;
                hot-path: root.sparkline-hot;
            }
            if root.sub-value != "" : Text {
                width: parent.width;
                height: parent.height;
                text: root.sub-value;
                color: root.value-color;
                font-size: Typography.body;
                vertical-alignment: bottom;
            }
        }
    }
}
