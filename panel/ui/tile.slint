import { Palette, Typography } from "tokens.slint";
import { Sparkline } from "sparkline.slint";

export enum TileState { normal, warm, hot }

export component MetricTile inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "--";
    in property <string> unit: "";
    in property <string> sub-value: "";
    in property <TileState> state: TileState.normal;
    in property <string> sparkline-path: "";

    property <color> value-color: root.state == TileState.hot ? Palette.error :
                                   root.state == TileState.warm ? Palette.warning :
                                   Palette.cool;

    min-width: 0;
    background: Palette.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;
    height: 130px;

    VerticalLayout {
        padding: 12px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 4px;
            Text {
                text: root.label;
                color: Palette.text-secondary;
                font-size: Typography.caption;
                horizontal-stretch: 1;
            }
            Text {
                text: root.state == TileState.hot ? "🔥" :
                      root.state == TileState.warm ? "⚠️" : "❄️";
                font-size: Typography.caption;
            }
        }

        HorizontalLayout {
            spacing: 4px;
            alignment: start;

            Text {
                text: root.value;
                color: root.value-color;
                font-size: Typography.value;
            }

            Text {
                text: root.unit;
                color: Palette.text-secondary;
                font-size: Typography.body;
                vertical-alignment: bottom;
            }
        }

        Sparkline {
            sparkline-path: root.sparkline-path;
            line-color: root.value-color;
            vertical-stretch: 1;
        }

        if root.sub-value != "" : Text {
            text: root.sub-value;
            color: root.value-color;
            font-size: Typography.body;
        }
    }
}
